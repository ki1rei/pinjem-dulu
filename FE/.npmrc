# Require (peer) dependency React 19 dari Radix UI, CVA, dan paket sejenis
# belum semuanya menyatakan kompatibel di package.json. legacy-peer-deps
# mencegah npm install gagal tanpa memaksa --force.
legacy-peer-deps=true

# Pastikan ekstensi file ditulis eksplisit agar node:test (ESM) tetap berjalan.
# save-exact=false (default) — patch boleh melayang.
